# Для запуска НА КОМПЬЮТЕРЕ: скопируйте этот файл в settings.env и заполните.
# На хостинге (BotHost) этот файл не нужен: те же значения вводятся в настройках бота.

# Токен бота от @BotFather (без кавычек и пробелов)
BOT_TOKEN=

# Ваш Telegram ID (узнать: написать боту @userinfobot). Можно несколько через запятую.
TEACHER_IDS=

# Часовой пояс и час, с которого начинается новый «день» бота (новый квиз, учёт серии)
TIMEZONE=Europe/Amsterdam
DAY_START_HOUR=5

# Сколько вопросов в квизе
QUIZ_SIZE=5

# Автоматика: во сколько напоминать ученикам и когда присылать дайджест вам
# (дайджест: 0 = понедельник … 6 = воскресенье)
REMIND_HOUR=18
DIGEST_WEEKDAY=0
DIGEST_HOUR=9
